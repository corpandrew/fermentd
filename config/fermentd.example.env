# Copy to config/fermentd.env on the Pi (not committed). Read by the MCP and backup units
# and by the MCP server for photo links.
# Address the MCP HTTP server listens on: your Pi's Tailscale IP (tailscale ip -4).
FERMENTD_MCP_HOST=127.0.0.1
FERMENTD_MCP_PORT=8765
# Base URL for photo links returned over MCP, e.g. https://fermentd.example.com
FERMENTD_DASHBOARD_URL=http://127.0.0.1:8080
# Optional backup overrides.
# FERMENTD_BACKUP_DIR=/home/pi/fermentd-backups
# FERMENTD_BACKUP_KEEP=14
