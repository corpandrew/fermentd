# Example Caddy front end for the dashboard over HTTPS on a tailnet.
# Copy to /etc/caddy/Caddyfile and replace fermentd.example.com and 100.64.0.1
# (your Pi's Tailscale IP). The dashboard itself stays on 127.0.0.1:8080.
# Caddy keeps the Host header and sends X-Forwarded-Proto, so the dashboard's
# CSRF origin check sees https://fermentd.example.com.
{
	auto_https disable_redirects
	default_bind 100.64.0.1
}

https://fermentd.example.com {
	tls /etc/caddy/certs/fermentd.crt /etc/caddy/certs/fermentd.key
	reverse_proxy 127.0.0.1:8080
}

http://fermentd.example.com, http://100.64.0.1 {
	redir https://fermentd.example.com{uri} permanent
}
